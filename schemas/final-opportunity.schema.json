{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talent Tree Final Opportunity",
  "type": "object",
  "required": [
    "canonical_job_id",
    "role",
    "commercial",
    "employer",
    "evidence",
    "qa",
    "client_status",
    "source_priority_stage"
  ],
  "properties": {
    "canonical_job_id": {
      "type": "string"
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "role": {
      "type": "object"
    },
    "commercial": {
      "type": "object",
      "properties": {
        "salary_gate": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "VERIFY"
          ]
        },
        "functional_scope": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "AGREED_CLIENT_EXCEPTION",
            "VERIFY"
          ]
        },
        "priority": {
          "enum": [
            "PRIORITY_1",
            "PRIORITY_2",
            "PRIORITY_3",
            "REJECT"
          ]
        },
        "existing_client": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "employer": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "ultimate_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement_scope_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runner_up": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_relevant": {
            "type": "string"
          },
          "employment_status": {
            "enum": [
              "CURRENT_VERIFIED",
              "CURRENT_PROBABLE",
              "CURRENT_UNVERIFIED",
              "FORMER",
              "CONTRADICTED"
            ]
          },
          "contact": {
            "type": [
              "string",
              "null"
            ]
          },
          "contact_status": {
            "enum": [
              "OBSERVED",
              "VERIFIED",
              "PATTERN_INFERRED",
              "CATCH_ALL",
              "UNVERIFIABLE",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "geography": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "province": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cluster_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 271
        },
        "node_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification_confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "boundary_rule_applied": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusion_status": {
          "enum": [
            "IN_SCOPE",
            "OUT_OF_SCOPE",
            "VERIFY"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "seniority": {
      "type": "object",
      "properties": {
        "band": {
          "enum": [
            "TIER_0_BOARD_AND_ENTERPRISE",
            "TIER_1_EXECUTIVE_LEADERSHIP",
            "TIER_1B_FRACTIONAL_INTERIM_PORTFOLIO",
            "TIER_2_DIRECTOR_HEAD",
            "TIER_3_SENIOR_MANAGEMENT",
            "TIER_4_PRINCIPAL_LEAD_ARCHITECT",
            "TIER_5_SPECIALIST",
            "TIER_6_CONSULTING",
            "TIER_7_EXPERIENCED_PROFESSIONAL",
            "UNKNOWN"
          ]
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "board_level": {
          "type": "boolean"
        },
        "executive_director": {
          "type": "boolean"
        },
        "fractional_or_interim": {
          "type": "boolean"
        },
        "consulting_track": {
          "type": "boolean"
        },
        "specialist_track": {
          "type": "boolean"
        },
        "people_management_required": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        }
      }
    },
    "client_status": {
      "enum": [
        "AGREED_CLIENT",
        "AGREED_GROUP_ENTITY",
        "PAST_CLIENT",
        "TARGET_PROSPECT",
        "UNKNOWN"
      ]
    },
    "source_priority_stage": {
      "enum": [
        "STAGE_1_AGREED_CLIENTS",
        "STAGE_2_STRATEGIC_AGENCIES",
        "STAGE_3_LINKEDIN_INTELLIGENCE",
        "STAGE_4_BROADER_SECONDARY_SOURCES"
      ]
    },
    "client_relationship": {
      "type": "object",
      "properties": {
        "matched_client_canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement_scope_status": {
          "enum": [
            "CONFIRMED",
            "UNRESOLVED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "identity_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "promotion_to_stage_1": {
          "type": "boolean"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}