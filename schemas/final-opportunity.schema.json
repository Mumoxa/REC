{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talent Tree Final Opportunity",
  "type": "object",
  "required": [
    "canonical_job_id",
    "role",
    "commercial",
    "employer",
    "evidence",
    "qa",
    "client_status",
    "search_channel",
    "stakeholder_map_status",
    "stakeholders",
    "contact_enrichment_gate",
    "company_email_intelligence"
  ],
  "properties": {
    "canonical_job_id": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical vacancy identity. Other workspace records reference this exact value."
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source appearance IDs (for example discovered-job.record_id); each source record links to this canonical vacancy."
    },
    "role": {
      "type": "object"
    },
    "commercial": {
      "type": "object",
      "properties": {
        "salary_gate": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "VERIFY"
          ]
        },
        "functional_scope": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "AGREED_CLIENT_EXCEPTION",
            "VERIFY"
          ]
        },
        "priority": {
          "enum": [
            "PRIORITY_1",
            "PRIORITY_2",
            "PRIORITY_3",
            "REJECT"
          ]
        },
        "existing_client": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "employer": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "ultimate_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement_scope_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runner_up": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason_relevant": {
            "type": "string"
          },
          "employment_status": {
            "enum": [
              "CURRENT_VERIFIED",
              "CURRENT_PROBABLE",
              "CURRENT_UNVERIFIED",
              "FORMER",
              "CONTRADICTED"
            ]
          },
          "contact": {
            "description": "Private-run business contact output. Do not commit live person-specific contact data to the public repository.",
            "type": [
              "string",
              "null"
            ]
          },
          "contact_status": {
            "enum": [
              "OBSERVED",
              "VERIFIED",
              "PATTERN_INFERRED",
              "CATCH_ALL",
              "CONFLICTING_PATTERN",
              "UNVERIFIABLE",
              "UNKNOWN"
            ]
          },
          "relevance": {
            "enum": [
              "PRIMARY_HIRING_OWNER",
              "FUNCTIONAL_DECISION_MAKER",
              "EXECUTIVE_SPONSOR",
              "TALENT_ACQUISITION",
              "HR_BUSINESS_PARTNER",
              "VACANCY_CONTACT",
              "REFERRAL_OR_AMPLIFIER",
              "POSSIBLE_STAKEHOLDER"
            ]
          },
          "profile_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_business_email": {
            "type": [
              "string",
              "null"
            ]
          },
          "suggested_probable_business_email": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_pattern_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "email_confidence_note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "geography": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "province": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cluster_label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 271
        },
        "node_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification_confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "boundary_rule_applied": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusion_status": {
          "enum": [
            "IN_SCOPE",
            "OUT_OF_SCOPE",
            "VERIFY"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "seniority": {
      "type": "object",
      "properties": {
        "band": {
          "enum": [
            "TIER_0_BOARD_AND_ENTERPRISE",
            "TIER_1_EXECUTIVE_LEADERSHIP",
            "TIER_1B_FRACTIONAL_INTERIM_PORTFOLIO",
            "TIER_2_DIRECTOR_HEAD",
            "TIER_3_SENIOR_MANAGEMENT",
            "TIER_4_PRINCIPAL_LEAD_ARCHITECT",
            "TIER_5_SPECIALIST",
            "TIER_6_CONSULTING",
            "TIER_7_EXPERIENCED_PROFESSIONAL",
            "UNKNOWN"
          ]
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "board_level": {
          "type": "boolean"
        },
        "executive_director": {
          "type": "boolean"
        },
        "fractional_or_interim": {
          "type": "boolean"
        },
        "consulting_track": {
          "type": "boolean"
        },
        "specialist_track": {
          "type": "boolean"
        },
        "people_management_required": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        }
      }
    },
    "client_status": {
      "enum": [
        "AGREED_CLIENT",
        "AGREED_GROUP_ENTITY",
        "PAST_CLIENT",
        "TARGET_PROSPECT",
        "UNKNOWN"
      ]
    },
    "source_priority_stage": {
      "enum": [
        "STAGE_1_AGREED_CLIENTS",
        "STAGE_2_STRATEGIC_AGENCIES",
        "STAGE_3_LINKEDIN_INTELLIGENCE",
        "STAGE_4_BROADER_SECONDARY_SOURCES"
      ],
      "description": "Deprecated compatibility field from the earlier sequential-stage model. Use search_channel for current runs.",
      "type": [
        "string",
        "null"
      ]
    },
    "client_relationship": {
      "type": "object",
      "properties": {
        "matched_client_canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement_scope_status": {
          "enum": [
            "CONFIRMED",
            "UNRESOLVED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "identity_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "promotion_to_stage_1": {
          "type": "boolean",
          "description": "Deprecated compatibility field. Use promote_to_agreed_client_priority."
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "promote_to_agreed_client_priority": {
          "type": "boolean"
        }
      }
    },
    "search_channel": {
      "enum": [
        "AGREED_CLIENTS",
        "AGENCY_SITES",
        "LINKEDIN",
        "JOB_BOARDS"
      ]
    },
    "role_resolution": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "HIGH_CONFIDENCE",
            "UNRESOLVED"
          ]
        },
        "exact_role_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "taxonomy_node_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 271
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "employer_resolution": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "CONFIRMED",
            "HIGH_CONFIDENCE",
            "UNRESOLVED"
          ]
        },
        "direct_employer": {
          "type": [
            "string",
            "null"
          ]
        },
        "legal_or_employing_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contact_enrichment_gate": {
      "type": "object",
      "required": [
        "eligible"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "role_gate_passed": {
          "type": "boolean"
        },
        "employer_gate_passed": {
          "type": "boolean"
        },
        "reason_if_blocked": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "company_email_intelligence": {
      "type": "object",
      "properties": {
        "website_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "employee_email_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain_status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "CONFLICTING",
            "UNKNOWN"
          ]
        },
        "observed_pattern_examples_count": {
          "type": "integer",
          "minimum": 0
        },
        "detected_pattern": {
          "type": [
            "string",
            "null"
          ]
        },
        "pattern_status": {
          "enum": [
            "CONFIRMED_PATTERN",
            "PROBABLE_PATTERN",
            "CONFLICTING_PATTERNS",
            "UNKNOWN_PATTERN"
          ]
        },
        "pattern_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alternate_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stakeholder_map_status": {
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "READY",
        "BLOCKED_WITH_EVIDENCE"
      ],
      "description": "Operational completion state for hiring-team/contact intelligence. COMPLETE opportunities may not leave this NOT_STARTED or IN_PROGRESS."
    },
    "stakeholder_map_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "Required evidence-grounded blocker note when stakeholder_map_status is BLOCKED_WITH_EVIDENCE."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stakeholder_map_status": {
            "const": "BLOCKED_WITH_EVIDENCE"
          }
        }
      },
      "then": {
        "required": [
          "stakeholder_map_note"
        ],
        "properties": {
          "stakeholder_map_note": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
