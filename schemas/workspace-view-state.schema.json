{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-view-state.schema.json",
  "title": "Talent Tree Recruitment Intelligence Workspace View State",
  "type": "object",
  "required": [
    "active_module",
    "vacancy_view",
    "layout"
  ],
  "properties": {
    "active_module": {
      "enum": [
        "VACANCIES",
        "COMPANIES",
        "CANDIDATE_MAPS",
        "CANDIDATES",
        "TOP_10",
        "QA",
        "RUNS",
        "EXPORTS"
      ]
    },
    "vacancy_view": {
      "enum": [
        "INBOX",
        "NEW",
        "AGREED_CLIENTS",
        "AGENCIES",
        "LINKEDIN",
        "JOB_BOARDS",
        "NEEDS_RESEARCH",
        "CLOSED_ARCHIVED"
      ]
    },
    "selected_vacancy_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "References final-opportunity.canonical_job_id; see interface/record-binding-contract.md."
    },
    "selected_candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "References candidate-market-map candidate_id; see interface/record-binding-contract.md."
    },
    "global_search": {
      "type": "string"
    },
    "vacancy_search": {
      "type": "string"
    },
    "candidate_search": {
      "type": "string"
    },
    "vacancy_filters": {
      "type": "object",
      "additionalProperties": true
    },
    "candidate_filters": {
      "type": "object",
      "additionalProperties": true
    },
    "vacancy_sort": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "COMMERCIAL_PRIORITY",
        "FIRST_SEEN_NEWEST",
        "UNRESOLVED_OLDEST",
        "LAST_VERIFIED",
        "QA_STATE",
        "CANDIDATE_COUNT",
        "TOP_10_READINESS",
        "SENIORITY",
        "GEOGRAPHY"
      ]
    },
    "candidate_sort": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "TOP_10_ORDER",
        "STRONGEST_MARKET_SET",
        "ENVIRONMENT_CLOSENESS",
        "REQUIREMENT_COVERAGE",
        "EVIDENCE_COMPLETENESS",
        "TARGET_COMPANY_TIER",
        "LAST_VERIFIED",
        "ALPHABETICAL"
      ]
    },
    "active_vacancy_tab": {
      "enum": [
        "OVERVIEW",
        "REQUIREMENTS",
        "SOURCES",
        "EMPLOYER",
        "STAKEHOLDERS",
        "CANDIDATE_MAP",
        "SEARCH_LOG",
        "QA",
        "HISTORY"
      ]
    },
    "date_window": {
      "type": "object",
      "properties": {
        "field": {
          "enum": [
            "POSTED_AT",
            "FIRST_SEEN_AT",
            "LAST_SEEN_AT",
            "LAST_VERIFIED_AT",
            "LAST_CHANGED_AT"
          ]
        },
        "preset": {
          "enum": [
            "ANY",
            "TODAY",
            "LAST_7_DAYS",
            "LAST_30_DAYS",
            "CUSTOM"
          ]
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "visible_fields": {
      "type": "object",
      "properties": {
        "vacancies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CLIENT_STATUS",
              "CHANNEL",
              "EMPLOYER_RESOLUTION",
              "LOCATION",
              "FIRST_SEEN",
              "LAST_VERIFIED",
              "QA_STATE",
              "CANDIDATE_COUNT",
              "TOP_10_COUNT",
              "LIFECYCLE"
            ]
          }
        },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "CURRENT_EMPLOYER",
              "CURRENT_TITLE",
              "LOCATION",
              "TARGET_TIER",
              "QUALIFICATION",
              "REQUIREMENT_COVERAGE",
              "EVIDENCE_STATUS",
              "QA_STATUS",
              "OPERATIONAL_STATUS",
              "LAST_VERIFIED"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "queue_scroll_position": {
      "type": "integer",
      "minimum": 0
    },
    "candidate_scroll_position": {
      "type": "integer",
      "minimum": 0
    },
    "saved_view_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "layout": {
      "type": "object",
      "required": [
        "vacancy_density",
        "middle_pane_state",
        "candidate_focus"
      ],
      "properties": {
        "vacancy_density": {
          "enum": [
            "EXPANDED",
            "COMPACT",
            "MINIMAL"
          ]
        },
        "middle_pane_state": {
          "enum": [
            "OPEN",
            "MINIMISED"
          ]
        },
        "candidate_focus": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
