{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-operational-state.schema.json",
  "title": "Talent Tree Workspace Operational State",
  "type": "object",
  "properties": {
    "vacancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vacancy_id",
          "lifecycle_status"
        ],
        "properties": {
          "vacancy_id": {
            "type": "string",
            "minLength": 1,
            "description": "Foreign key to final-opportunity.canonical_job_id; see interface/record-binding-contract.md."
          },
          "lifecycle_status": {
            "enum": [
              "DISCOVERED",
              "VERIFYING",
              "QUALIFIED",
              "EMPLOYER_RESOLVED",
              "CANDIDATE_MAPPING",
              "TOP_10_READY",
              "CLIENT_ACTION",
              "CLOSED"
            ]
          },
          "closed_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "FILLED",
              "EXPIRED",
              "CLIENT_NO_LONGER_HIRING",
              "NOT_COMMERCIALLY_RELEVANT",
              "DUPLICATE",
              "CANCELLED",
              "OTHER"
            ]
          },
          "closed_reason_detail": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": ".*\\S.*"
          },
          "closed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "unread": {
            "type": "boolean"
          },
          "last_user_action_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle_status": {
                  "const": "CLOSED"
                }
              },
              "required": [
                "lifecycle_status"
              ]
            },
            "then": {
              "required": [
                "closed_reason",
                "closed_at"
              ],
              "properties": {
                "closed_reason": {
                  "type": "string",
                  "enum": [
                    "FILLED",
                    "EXPIRED",
                    "CLIENT_NO_LONGER_HIRING",
                    "NOT_COMMERCIALLY_RELEVANT",
                    "DUPLICATE",
                    "CANCELLED",
                    "OTHER"
                  ]
                },
                "closed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "closed_reason": {
                  "const": "OTHER"
                }
              },
              "required": [
                "closed_reason"
              ]
            },
            "then": {
              "required": [
                "closed_reason_detail"
              ],
              "properties": {
                "closed_reason_detail": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    },
    "candidate_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "vacancy_id",
          "candidate_id",
          "operational_status"
        ],
        "properties": {
          "vacancy_id": {
            "type": "string",
            "minLength": 1,
            "description": "Foreign key to final-opportunity.canonical_job_id; see interface/record-binding-contract.md."
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "description": "Foreign key to candidate-market-map candidate_id; see interface/record-binding-contract.md."
          },
          "operational_status": {
            "enum": [
              "SURFACED",
              "RELEVANT",
              "EARMARKED",
              "TOP_10",
              "APPROACH",
              "ENGAGED",
              "SUBMITTED",
              "EXCLUDED"
            ]
          },
          "excluded_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_user_action_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operational_status": {
                  "const": "EXCLUDED"
                }
              },
              "required": [
                "operational_status"
              ]
            },
            "then": {
              "required": [
                "excluded_reason"
              ],
              "properties": {
                "excluded_reason": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": ".*\\S.*"
                }
              }
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
