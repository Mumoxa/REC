{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Talent Tree Discovered Job",
  "type": "object",
  "required": [
    "record_id",
    "discovered_at",
    "source",
    "classification",
    "role",
    "evidence",
    "client_status",
    "source_priority_stage"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "parent_signal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "discovered_at": {
      "type": "string"
    },
    "posted_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "classification": {
      "enum": [
        "CONFIRMED_VACANCY",
        "PROBABLE_VACANCY",
        "MULTI_ROLE_HIRING",
        "EARLY_HIRING_SIGNAL",
        "EXECUTIVE_DEPARTURE",
        "BUSINESS_EXPANSION",
        "HIRING_AUTHOR",
        "REPOST",
        "AGENCY_ADVERT",
        "IRRELEVANT"
      ]
    },
    "role": {
      "type": "object",
      "properties": {
        "raw_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "normalized_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "function": {
          "type": [
            "string",
            "null"
          ]
        },
        "seniority": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "channel",
        "source_name",
        "url"
      ],
      "properties": {
        "channel": {
          "enum": [
            "linkedin",
            "agency",
            "jobboard",
            "ats",
            "direct_careers",
            "web_xray",
            "other"
          ]
        },
        "source_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "author": {
          "type": [
            "string",
            "null"
          ]
        },
        "advertiser": {
          "type": [
            "string",
            "null"
          ]
        },
        "advertiser_type": {
          "enum": [
            "DIRECT",
            "THIRD_PARTY",
            "UNKNOWN"
          ]
        }
      }
    },
    "employer": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "existing_client": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "properties": {
        "functional_scope": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "VERIFY",
            "NOT_YET_ASSESSED"
          ]
        },
        "salary_gate": {
          "enum": [
            "INCLUDE",
            "EXCLUDE",
            "VERIFY",
            "NOT_YET_ASSESSED"
          ]
        },
        "freshness": {
          "enum": [
            "ACTIVE",
            "PROBABLY_ACTIVE",
            "QUESTIONABLE",
            "STALE",
            "INVALID_SPAM",
            "UNKNOWN"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status",
          "basis"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED",
              "PROBABLE",
              "HYPOTHESIS",
              "UNKNOWN"
            ]
          },
          "basis": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "possible_duplicate_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "geography": {
      "type": "object",
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "province": {
          "type": [
            "string",
            "null"
          ]
        },
        "city": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "region_priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "cluster_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "cluster_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "search_term_matched": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "node_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 271
        },
        "node_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "group_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification_confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "boundary_rule_applied": {
          "type": [
            "string",
            "null"
          ]
        },
        "exclusion_status": {
          "enum": [
            "IN_SCOPE",
            "OUT_OF_SCOPE",
            "VERIFY",
            "NOT_YET_ASSESSED"
          ]
        },
        "exclusion_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "seniority": {
      "type": "object",
      "properties": {
        "band": {
          "enum": [
            "TIER_0_BOARD_AND_ENTERPRISE",
            "TIER_1_EXECUTIVE_LEADERSHIP",
            "TIER_1B_FRACTIONAL_INTERIM_PORTFOLIO",
            "TIER_2_DIRECTOR_HEAD",
            "TIER_3_SENIOR_MANAGEMENT",
            "TIER_4_PRINCIPAL_LEAD_ARCHITECT",
            "TIER_5_SPECIALIST",
            "TIER_6_CONSULTING",
            "TIER_7_EXPERIENCED_PROFESSIONAL",
            "UNKNOWN"
          ]
        },
        "matched_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "board_level": {
          "type": "boolean"
        },
        "executive_director": {
          "type": "boolean"
        },
        "fractional_or_interim": {
          "type": "boolean"
        },
        "consulting_track": {
          "type": "boolean"
        },
        "specialist_track": {
          "type": "boolean"
        },
        "people_management_required": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "CONFIRMED",
            "PROBABLE",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        }
      }
    },
    "client_status": {
      "enum": [
        "AGREED_CLIENT",
        "AGREED_GROUP_ENTITY",
        "PAST_CLIENT",
        "TARGET_PROSPECT",
        "UNKNOWN"
      ]
    },
    "source_priority_stage": {
      "enum": [
        "STAGE_1_AGREED_CLIENTS",
        "STAGE_2_STRATEGIC_AGENCIES",
        "STAGE_3_LINKEDIN_INTELLIGENCE",
        "STAGE_4_BROADER_SECONDARY_SOURCES"
      ]
    },
    "client_relationship": {
      "type": "object",
      "properties": {
        "matched_client_canonical": {
          "type": [
            "string",
            "null"
          ]
        },
        "matched_entity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agreement_scope_status": {
          "enum": [
            "CONFIRMED",
            "UNRESOLVED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "identity_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "promotion_to_stage_1": {
          "type": "boolean"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}