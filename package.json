{
  "name": "talent-tree-recruitment-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test:contracts": "node tests/run-completion-contract-smoke.mjs && node tests/agent-publication-contract-smoke.mjs && node tests/hiring-team-intelligence-smoke.mjs",
    "test:regression": "node tests/rec-product-regression.mjs",
    "test:unit": "vitest run",
    "test": "npm run test:contracts && npm run test:regression && npm run test:unit",
    "rec:publish": "node scripts/rec-publish.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test:contracts && npm run test:regression && npm run test:unit && npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
